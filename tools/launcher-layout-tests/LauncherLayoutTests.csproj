<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>LauncherLayoutTests</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <!-- Runs the launcher's real window without a screen: Avalonia's headless platform, drawn with Skia. -->
    <PackageReference Include="Avalonia.Headless" Version="12.1.5" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.5" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\launcher\ScoobyReMasked.Launcher.csproj" />
  </ItemGroup>
</Project>
